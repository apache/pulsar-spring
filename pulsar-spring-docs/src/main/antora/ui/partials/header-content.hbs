<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="https://pulsar.apache.org/">
        <img id="pulsarlogo" class="block" src="{{{uiRootPath}}}/img/logo-black.svg" alt="Apache Pulsar" />
      </a>
      <button class="navbar-burger" data-target="topbar-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="https://pulsar.apache.org/docs/">Pulsar Docs</a>
        <a class="navbar-item" href="https://pulsar.apache.org/community/">Community</a>
        <a class="navbar-item" href="https://github.com/apache/pulsar-spring">GitHub</a>
        <a class="navbar-item pulsar-download" href="https://pulsar.apache.org/download/">Download</a>
      </div>
    </div>
    {{#if (eq env.SITE_SEARCH_PROVIDER 'lunr')}}
    <div class="pulsar-search">
      <input id="search-input" type="search" placeholder="Search" aria-label="Search the documentation" autocomplete="off" />
    </div>
    {{/if}}
    <label class="theme-toggler">
      <input type="checkbox" id="switch-theme-checkbox" name="switch-theme-checkbox" aria-label="Dark theme" />
      <span class="icon">
        <svg class="sun" aria-hidden="true" viewBox="0 0 16 16">
          <circle cx="8" cy="8" r="3.5" fill="currentColor"></circle>
          <path d="M8 0v2.5M8 13.5V16M0 8h2.5M13.5 8H16M2.3 2.3l1.8 1.8M11.9 11.9l1.8 1.8M2.3 13.7l1.8-1.8M11.9 4.1l1.8-1.8" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <svg class="moon" aria-hidden="true" viewBox="0 0 16 16">
          <path d="M13 11A6.5 6.5 0 0 1 5 3a6.5 6.5 0 1 0 8 8z" fill="currentColor"></path>
        </svg>
      </span>
      <span class="text">Theme</span>
    </label>
  </nav>
</header>
<script>
document.getElementById('switch-theme-checkbox').parentElement.classList.toggle('active', document.documentElement.classList.contains('dark-theme'))
</script>
